# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Local development default (assumes a local Postgres listening on localhost:5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deafference_dev?schema=public"

# Server Configuration
# Express API port. Kept distinct from the Next.js dev server (which uses 3000)
# so the frontend and API can run simultaneously.
PORT=4000
NODE_ENV=development

# Optional: Log level
LOG_LEVEL=debug
