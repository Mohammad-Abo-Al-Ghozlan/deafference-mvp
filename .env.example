# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Local development default (assumes a local Postgres listening on localhost:5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deafference_dev?schema=public"

# Server Configuration
# Express API port. Kept distinct from the Next.js dev server (which uses 3000)
# so the frontend and API can run simultaneously.
PORT=4000
NODE_ENV=development

# Optional: Log level
LOG_LEVEL=debug

# API access token (bearer). When set, every /api route requires
# `Authorization: Bearer <token>`. REQUIRED in production — without it the server
# refuses to serve when NODE_ENV=production. Generate a long random value.
API_ACCESS_TOKEN="change-me-to-a-long-random-secret"

# CORS allowlist — comma-separated origins permitted to call the API from a
# browser. Leave empty in local dev (permits all); MUST be set in production.
# Example: ALLOWED_ORIGINS="https://app.deafference.com,https://www.deafference.com"
ALLOWED_ORIGINS=""

# ── live_demo.py  `--ai`  sentence generation (optional) ─────────────────────
# Comma-separated Google Gemini API keys (free tier). Get keys at
# https://aistudio.google.com/apikey . NEVER commit real keys — put them only in
# your local .env (which is gitignored).
GEMINI_API_KEYS="your-gemini-key-1,your-gemini-key-2"
GEMINI_MODEL="gemini-2.5-flash-lite"
# To use Claude instead:  SENTENCE_PROVIDER=anthropic  and  ANTHROPIC_API_KEY=...
# SENTENCE_PROVIDER=gemini
