{
 "schema": "asl-handedness/v1",
 "date": "2026-08-11",
 "author": "Mohammad Salim (data pipeline)",
 "why": [
  "Handedness is NOT derivable from the GISLR landmarks. Measured against the raw",
  "competition data on 2026-08-11: 300 random sequences of known two-handed signs,",
  "21 participants -> BOTH hands live in 1.7% of clips, frames with both hands mean",
  "0.1% / max 4.8%, and 14/21 participants have EVERY clip single-handed. The corpus",
  "records one hand per participant. Four landmark-derived classifiers were tested",
  "against 40 hand-labelled words and all failed: wrist path-length ratio AUC 0.335",
  "(inverted), spatial-extent ratio 0.460, passive-wrist-height 0.468, weaker-hand",
  "presence 0.500. So the classification is supplied here as lexical knowledge."
 ],
 "classes": {
  "1": "One-handed. Only the dominant hand is phonemically required.",
  "2s": "Two-handed SYMMETRIC (Battison's Symmetry Condition): both hands share the same handshape and both move. The passive hand can be reconstructed EXACTLY by mirroring the dominant hand — no synthesis assumptions needed.",
  "2a": "Two-handed ASYMMETRIC (Battison's Dominance Condition): the dominant hand acts on a static passive base. The passive hand is restricted to an unmarked handshape (B, A, S, 1, 5, C, O), so it is predictable but is NOT a mirror of the dominant hand."
 },
 "renderer_contract": [
  "For every word not marked '1', the passive hand's landmarks DO NOT EXIST in our",
  "corpus for any take. The exported clip carries the dominant hand only. The avatar",
  "must synthesize the passive hand:",
  "  2s -> mirror the dominant hand across the body midline.",
  "  2a -> place an unmarked handshape at the base location; do not mirror.",
  "No exemplar selection can change this, and check-export.py will correctly flag",
  "'one hand absent' on every 2s/2a word forever. That is the data, not the export."
 ],
 "conf": {
  "high": "Unambiguous in standard ASL; safe to rely on.",
  "med": "Regional or child-register variation exists, or the sign has both a one- and two-handed form. Prioritise these for Deaf review."
 },
 "counts": {
  "one_handed": 163,
  "two_handed_symmetric": 52,
  "two_handed_asymmetric": 35
 },
 "review_status": "NOT yet reviewed by a Deaf signer. Written from ASL phonology by a hearing developer. The 'med' entries are where errors are most likely.",
 "cross_check": {
  "against": "animation side's independent labelling (Fix/HANDED_1.PY, 96 signs)",
  "comparable": 92,
  "agreement": "84/92 = 91%",
  "both_max_confidence_disagreements": 0,
  "resolved": {
   "table": "2s -> 2a, conceded: the passive forearm is a static base (Dominance), not a mirrored hand (Symmetry). Mirroring it would have been a visible renderer error."
  },
  "open_disagreements": {
   "sad": "his ONE(2) vs our 2s(high) — both 5 hands down the face in the form we know; one-handed variants exist",
   "toy": "his ASYM(1) vs our 2s(high) — two T hands shake, we read it symmetric",
   "napkin": "his ASYM(1) vs our 1(high) — wipe-the-mouth is one-handed in the form we know",
   "shower": "his SYM(1) vs our 1(high) — one hand above the head, opening",
   "cut": "both low confidence",
   "owie": "both low confidence",
   "refrigerator": "both low confidence"
  },
  "note": "These 7 plus the 45 'med' entries are the Deaf-review priority list. Do not resolve them by argument between two hearing developers."
 },
